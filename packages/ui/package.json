    "./components/input": "./src/components/input.tsx",
    "./components/label": "./src/components/label.tsx",
    "./components/native-select": "./src/components/native-select.tsx",
    "./slots": "./src/slots.ts",
    "./lib/classes": "./src/lib/classes.ts",
    "./styles/controls.css": "./src/styles/controls.css",
    "./styles/timetable.css": "./src/styles/timetable.css",
    "./styles/showroom.css": "./src/styles/showroom.css",
    "./eslint/config": "./eslint/config.mjs",
    "./design-contract": "./src/design-contract.mjs",
    "./styles/library.css": "./src/styles/library.css",
    "./styles/staff-web.css": "./src/styles/staff-web.css",
    "./toast": "./src/components/staff-toast.tsx",
    "./toast-text": "./src/lib/toast-text.ts",
    "./styles/toast.css": "./src/styles/toast.css",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/inline-slots.test.mjs eslint/policy.test.mjs test/react-native-props.mjs test/public-css-contract.test.mjs test/public-render.test.cjs test/public-svg-fill.test.mjs",
    "test:lint": "node --test eslint/official-integration.mjs",
    "test:react": "node --test test/react-native-props.mjs",
