{
  "name": "@vintage/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./src/components/index.ts",
    "./components": "./src/components/index.ts",
