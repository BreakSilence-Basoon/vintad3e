    "react": "19.2.4"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@types/react": "^19",
    "@typescript-eslint/parser": "8.58.1",
    "eslint": "9.39.4",
    "react": "19.2.4",
    "typescript": "5.9.3",
    "react-dom": "19.2.4"
  }
